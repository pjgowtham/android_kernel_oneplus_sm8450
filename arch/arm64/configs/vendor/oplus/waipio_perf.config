# Kernel command line
CONFIG_CMDLINE="console=ttynull stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off kvm-arm.mode=protected bootconfig"

# Alert Slider
CONFIG_IST_DOWN=m
CONFIG_IST_UP=m
CONFIG_MXM_DOWN=m
CONFIG_MXM_UP=m
CONFIG_OPLUS_TRIKEY_HALL=m
CONFIG_OPLUS_TRIKEY_MAIN=m

# Display
CONFIG_OPLUS_FPGA_NOTIFY=m
CONFIG_OPLUS_TRACKPOINT_REPORT=m

# Fingerprint
CONFIG_OPLUS_FINGERPRINT_GKI_ENABLE=y
CONFIG_UFF_FINGERPRINT=m
CONFIG_UFF_FINGERPRINT_QCOM=y

# IR
CONFIG_OPLUS_SENSOR_CONSUMER_IR_CORE=m
CONFIG_OPLUS_SENSOR_CONSUMER_IR_QC=m

# Misc
CONFIG_FRAME_WARN=0
CONFIG_OPLUS_FEATURE_BOOTMODE=m
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m
CONFIG_OPLUS_FEATURE_CHARGERPRESENT=m
CONFIG_OPLUS_FEATURE_FEEDBACK=m
CONFIG_OPLUS_FEATURE_FTMMODE=m
CONFIG_OPLUS_FEATURE_MM_FEEDBACK=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y

# Power
CONFIG_INPUT_QPNP_POWER_ON=m
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
CONFIG_OPLUS_ADSP_CHARGER=y
CONFIG_OPLUS_CALL_MODE_SUPPORT=y
CONFIG_OPLUS_CHARGER=y
CONFIG_OPLUS_CHECK_CHARGERID_VOLT=y
CONFIG_OPLUS_CHG=m
CONFIG_OPLUS_CHG_DYNAMIC_CONFIG=y
CONFIG_OPLUS_CHG_IC_DEBUG=y
CONFIG_OPLUS_CHG_MMS_DEBUG=y
CONFIG_OPLUS_CHG_V2=m
CONFIG_OPLUS_CHIP_SOC_NODE=y
CONFIG_OPLUS_DA9313_CHARGER=y
CONFIG_OPLUS_I2C_RST_NOTIFY=m
CONFIG_OPLUS_MP2762_CHARGER=y
CONFIG_OPLUS_PD_MANAGER_CHARGER=y
CONFIG_OPLUS_PD_EXT_SUPPORT=y
CONFIG_OPLUS_SGM41512_CHARGER=y
CONFIG_OPLUS_SHIP_MODE_SUPPORT=y
CONFIG_OPLUS_SM8450_CHARGER=y
CONFIG_OPLUS_SMART_CHARGER_SUPPORT=y
# CONFIG_PD_DBG_INFO is not set
CONFIG_TCPC_CLASS=m
CONFIG_TCPC_RT1711H=y
CONFIG_USB_POWER_DELIVERY=m

# Sensor
CONFIG_OPLUS_FEATURE_SENSOR_CFG=m
CONFIG_OPLUS_SENSOR_DRM_PANEL_ADFR_MIN_FPS=y
CONFIG_OPLUS_SENSOR_DRM_PANEL_NOTIFY=m
CONFIG_OPLUS_SENSOR_FB_QC=m
CONFIG_SSC_INTERACTIVE=m

# Touchpanel
CONFIG_OPLUS_DEVICE_IFNO=m
CONFIG_OPLUS_FW_UPDATE=m
CONFIG_TOUCHPANEL_CUSTOM=m
CONFIG_TOUCHPANEL_LATE_INIT=y
CONFIG_TOUCHPANEL_NOTIFY=m
CONFIG_TOUCHPANEL_OPLUS=m
CONFIG_TOUCHPANEL_SYNAPTICS=m
CONFIG_TOUCHPANEL_SYNAPTICS_TCM_ONCELL=m
CONFIG_TOUCHPANEL_SYNAPTICS_TCM_S3910=m
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_FTS is not set

# UFS
CONFIG_OPLUS_QCOM_UFS_DRIVER=y
CONFIG_OPLUS_UFS_DRIVER=m

# Temporary cross-version module loading test
CONFIG_MODULE_FORCE_LOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_PROTECT is not set
